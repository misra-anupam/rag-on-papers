# ── Source APIs ───────────────────────────────────────────────────────────────
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=you@example.com

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_BUCKET_NAME=rag-medical-papers
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
