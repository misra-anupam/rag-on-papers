# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-...

# ── Source APIs ───────────────────────────────────────────────────────────────
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
UNPAYWALL_EMAIL=you@example.com

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_BUCKET_NAME=rag-medical-papers
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
# Local testing: point boto3 at the bundled MinIO service. The credentials above
# double as MinIO's root user/password. Leave S3_ENDPOINT_URL empty to use real AWS S3.
S3_ENDPOINT_URL=http://minio:9000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://rag:changeme@postgres:5432/rag_registry

# ── Celery / RabbitMQ / Redis ─────────────────────────────────────────────────
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=

# ── Grobid ────────────────────────────────────────────────────────────────────
GROBID_URL=http://grobid:8070

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000
